# ===== 台股本地量化系統 環境變數範本 =====
# 複製為 .env 後填入。切勿將 .env 提交到 Git。

# ---- 資料來源 ----
# FinMind API token（可選；免費版可用但有限流）
FINMIND_TOKEN=

# ---- 行情來源（P3；未設定則完全不進行行情輪詢）----
# 可用：finmind_minute（延遲，唯一預設啟用）| mis（即時端點，需 opt-in）| fake（測試用假資料）
# ⚠️ 本專案目前沒有「已查證的免費即時行情」；finmind_minute 延遲未載明，一律歸為延遲
# TWSTOCK_QUOTE_SOURCE=
# MIS 端點受 TWSE 條款限制（禁止未經同意的自動化擷取）；僅供個人研究場景明確 opt-in
# TWSTOCK_QUOTE_ALLOW_MIS=
# 行情有效年齡門檻是指令參數（python -m twstock.cli quotes --max-age 300），非環境變數（預設 300 秒）

# ---- 通知（可選；未填則只產生報告不推送）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- AI 側邊建議（可選；未填則使用規則式降級）----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- 本機執行設定 ----
# 執行模式：research | backtest | paper（預設） | live（正式交易，預設關閉）
TWSTOCK_MODE=paper
# 正式交易需明確認可；未設為 1 時即使 TWSTOCK_MODE=live 也不會啟用（安全鎖）
# TWSTOCK_LIVE_ACK=1

# 資料庫位置（預設 twstock/data_store/twstock_v3.db）
# TWSTOCK_DB_PATH=
# 自訂資料目錄（預設 twstock/data_store）
# TWSTOCK_DATA_DIR=
# 唯讀保護：設為 1 時完全不寫入資料庫（安全分析用）
# TWSTOCK_READONLY=1

# ---- 券商 API（尚未整合；正式交易預設關閉）----
# 憑證只能放在本機 .env 或系統環境變數，絕不可進 Git／前端／日誌
# TWSTOCK_BROKER_API_KEY=
# TWSTOCK_BROKER_ACCOUNT=
