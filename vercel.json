{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python -m compileall -q twstock api",
  "regions": [
    "hkg1"
  ],
  "env": {
    "TWSTOCK_READONLY": "1"
  },
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "outputDirectory": "public"
}
